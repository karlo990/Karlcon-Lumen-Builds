# Copy to stream.env and fill in. Keep stream.env private: the stream key lets anyone broadcast as you.
#
# Instagram Live (Live Producer on instagram.com, or Meta Business Suite): paste the Server URL and the
# Stream key together, e.g.  rtmps://edgetee-upload-xxx.xx.fbcdn.net:443/rtmp/  +  FB-123456789-0-Ab...
# Facebook Live (Live Producer, "Streaming software"): the same, rtmps://live-api-s.facebook.com:443/rtmp/<key>
# YouTube: rtmp://a.rtmp.youtube.com/live2/<key>
STREAM_URL="rtmps://live-api-s.facebook.com:443/rtmp/PASTE-YOUR-STREAM-KEY"

# Folder with the rendered .mp4 files (default: videos/ next to this script)
# VIDEO_DIR="/opt/karlcon-stream/videos"

# name = play in file-name order (01-ep1.mp4, 02-…); shuffle = a new order each time the stream (re)starts
ORDER="name"
