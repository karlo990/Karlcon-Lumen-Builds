[Unit]
Description=KARLCON Studio loop stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/karlcon-stream
ExecStart=/opt/karlcon-stream/stream.sh
Restart=always
RestartSec=5
# stop retrying for a minute if it fails 10 times in 2 minutes (a wrong or expired key)
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
